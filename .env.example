# Nebius Token Factory API key (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=

# Optional overrides (defaults shown)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# EMBER_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# EMBER_MODEL_CODER=nvidia/nemotron-3-super-120b-a12b
# EMBER_MODEL_REASONER=nvidia/Nemotron-3-Ultra-550b-a55b
# EMBER_FIX_BRANCHES=3
# EMBER_TEST_CMD=          # override the detected test command for /fix
# EMBER_THINK_BUDGET=4096  # reasoning-token cap per request on Token Factory; `off` to disable
# EMBER_KEEP_REASONING=0   # on by default; 0 stops replaying each step's reasoning to the model within a task
