# Nebius Token Factory API key (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=

# Set this to run code in Nebius Sandboxes (microVMs). Without it, FailFirst uses local Podman.
NEBIUS_PROJECT_ID=

# Optional: raises the GitHub API rate limit for fetching issues and repos.
GITHUB_TOKEN=

# Optional overrides (defaults shown)
# FAILFIRST_MODEL_FAST=nvidia/Nemotron-3-Nano-30B-A3B
# FAILFIRST_MODEL_CODER=nvidia/Nemotron-3-Super-120b-a12b
# FAILFIRST_MODEL_REASONER=nvidia/Nemotron-3-Ultra-550b-a55b
# FAILFIRST_SANDBOX=auto            # auto | nebius | podman
# FAILFIRST_BRANCHES=3
# FAILFIRST_ALLOW_LIVE_RUNS=true    # false = replay-only public demo
