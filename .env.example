# Copy to .env (gitignored) or to ~/.config/ember/env. Real environment variables win over both.
#
# Nothing here is required to build, test, or run `ember --help` / `ember --version`.
# The full-screen UI starts without a key and tells you this file is missing.
# A model call needs either NEBIUS_API_KEY, or EMBER_BASE_URL pointed at an
# OpenAI-compatible server (a local server does not need a Nebius key).

# Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys).
# Required only when EMBER_BASE_URL is the default Token Factory host.
NEBIUS_API_KEY=

# OpenAI-compatible base URL. Unset uses Token Factory.
# Set this to a local server (llama.cpp, vLLM, NIM, ...) to run with no Nebius key:
# EMBER_BASE_URL=http://127.0.0.1:8000/v1
# NEBIUS_BASE_URL is the older name for the same setting. EMBER_BASE_URL wins.

# Optional. Enables web_search, and makes web_fetch use Tavily Extract.
# Without it, ember still runs; web_search is omitted and web_fetch fetches the page itself.
# TAVILY_API_KEY=

# Model ids. Defaults are the Nemotron tiers in the README.
# EMBER_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# EMBER_MODEL_CODER=nvidia/nemotron-3-super-120b-a12b
# EMBER_MODEL_REASONER=nvidia/Nemotron-3-Ultra-550b-a55b
# EMBER_MODEL_DRAFT=nvidia/Nemotron-3_5-Lightning
# EMBER_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL

# /fix and reasoning. Defaults shown.
# EMBER_FIX_BRANCHES=3
# EMBER_TEST_CMD=          # override the detected test command
# EMBER_THINK=on           # on | low | off, same as --think
# EMBER_THINK_BUDGET=4096  # reasoning-token cap on Token Factory; `off` to disable
# EMBER_KEEP_REASONING=on  # 0 turns off replaying each step's reasoning within a task
# EMBER_MAX_STEPS=80
# EMBER_NO_WEB=            # 1 removes web_search and web_fetch
# EMBER_VERBOSE=           # 1 logs every /fix tool call in print mode
# GITHUB_TOKEN=            # optional; used when /fix is given a github.com issue URL

# Terminal. Defaults are fine for a normal session.
# EMBER_MOUSE=on
# EMBER_HEADER=on
# EMBER_COLORS=            # auto, or 256, or truecolor
# EMBER_THEME=kawaii       # or classic
# EMBER_SESSION_DAYS=30    # 0 keeps saved conversations
# EMBER_REPO_MAP=          # 0 turns the repo map off
# EMBER_REDUCED_MOTION=    # 1 disables cosmetic animation
# EMBER_LOG=               # path; append tool calls for debugging
